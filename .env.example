# ============================================================================
# 邮箱数字人 · 环境变量示例
#
# 用法：复制为 .env 后按需填写。环境变量的优先级高于 data/config.json，
# 因此推荐把「授权码 / API Key」这类密钥只放在 .env 里，不要写进 config.json。
#
# 支持多邮箱实例：下面的 MAILBOT_IMAP_* / MAILBOT_SMTP_* / MAILBOT_EMAIL
# 只作用于「第一个实例」（通常是默认实例），其余实例请在界面「设置」里配置。
# ============================================================================

# ---------------------------------------------------------------- 邮箱（IMAP 收信）
MAILBOT_IMAP_HOST=imap.exmail.qq.com
MAILBOT_IMAP_PORT=993
# true=SSL/TLS（993/465 用 true）；false=STARTTLS 或明文（143/587 用 false）
MAILBOT_IMAP_SECURE=true
MAILBOT_IMAP_USER=you@yourcompany.com
# 授权码 / 客户端专用密码（不是网页登录密码）
MAILBOT_IMAP_PASS=

# ---------------------------------------------------------------- 邮箱（SMTP 发信）
MAILBOT_SMTP_HOST=smtp.exmail.qq.com
MAILBOT_SMTP_PORT=465
MAILBOT_SMTP_SECURE=true
MAILBOT_SMTP_USER=you@yourcompany.com
# 留空则复用 IMAP 的授权码
MAILBOT_SMTP_PASS=
# SMTP 认证方式：auto（默认）/ LOGIN / PLAIN
# 若报「535 authentication failed, system busy」，改成 LOGIN 往往能通
MAILBOT_SMTP_AUTH_METHOD=auto

# ---------------------------------------------------------------- 发件身份
MAILBOT_SENDER_NAME=王磊
MAILBOT_EMAIL=you@yourcompany.com

# ---------------------------------------------------------------- 大模型（DeepSeek 官方 API）
DEEPSEEK_API_KEY=
# 如需换成其它 OpenAI 兼容服务：
# MAILBOT_LLM_BASE_URL=https://api.deepseek.com
# MAILBOT_LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------- 日历数字人（Google Calendar）
# 启用日历功能（也可以在界面「设置 → 日历数字人」里开启）
MAILBOT_CALENDAR_ENABLED=false
# Google Cloud「Web 应用」OAuth 客户端凭据
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必须与 Google Cloud 里登记的「授权重定向 URI」完全一致
MAILBOT_GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/calendar/oauth/callback
# 目标日历：primary=主日历，也可填 xxx@group.calendar.google.com
MAILBOT_CALENDAR_ID=primary
# 【重要】访问 Google 走的 HTTP 代理。Node 不会自动使用系统代理，
# 所以「浏览器能打开 Google、本程序报网络错误」通常就是这里没填。
# 填代理软件提供的 HTTP 端口，例如 http://127.0.0.1:7890（不支持 SOCKS，请用它的 HTTP 端口）。
# 只影响日历 / Google 授权，不影响收发邮件与大模型。
MAILBOT_GOOGLE_PROXY=
# 所有自然语言时间都按这个时区解释
MAILBOT_TIMEZONE=Asia/Shanghai
# 新日程是否给参与者发邀请：none（推荐）/ all / externalOnly
MAILBOT_CALENDAR_SEND_UPDATES=none
# 「最近 N 天」分析窗口
MAILBOT_CALENDAR_LOOKAHEAD_DAYS=7

# ---------------------------------------------------------------- Web 服务
MAILBOT_WEB_HOST=127.0.0.1
MAILBOT_WEB_PORT=8787
# 非空时，浏览器需带同样令牌才能访问 API（单机自用可留空）
MAILBOT_WEB_TOKEN=

# ---------------------------------------------------------------- 其它
# 数据目录（配置 / 状态 / 报告 / 原文归档）
# MAILBOT_DATA_DIR=./data
# 默认回看窗口（小时）
# MAILBOT_WINDOW_HOURS=24
# 日志级别：debug | info | warn | error | silent
MAILBOT_LOG_LEVEL=info
